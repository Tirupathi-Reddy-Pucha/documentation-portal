# M.A.C.H. (MACH AI) — Environment Variables
# Copy this file to .env and fill in your values before running the backend.

# --- Ollama (LLM) ---
# Set the base URL to your Ollama server.
# If using Google Colab with Ngrok, paste the Ngrok tunnel URL here.
# If running Ollama locally, keep the default.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL=gemma4:12b-it-qat
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Cloudinary (Image Storage) ---
# Sign up free at https://cloudinary.com and copy your credentials from the dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- PostgreSQL (stores document text and vector embeddings) ---
# Use POSTGRES_HOST=postgres if running the backend in Docker Compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=curriculumlens
POSTGRES_USER=cluser
POSTGRES_PASSWORD=clpassword

# --- Neo4j (stores the Knowledge Graph) ---
# Use bolt://neo4j:7687 if running the backend in Docker Compose
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=clpassword
